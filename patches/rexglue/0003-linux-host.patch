diff --git a/include/rex/input/mmjoystick/sdl_joystick_compat.h b/include/rex/input/mmjoystick/sdl_joystick_compat.h
new file mode 100644
index 0000000..4779c9e
--- /dev/null
+++ b/include/rex/input/mmjoystick/sdl_joystick_compat.h
@@ -0,0 +1,43 @@
+#pragma once
+// Read the existing raw joystick binding format through SDL3 on Linux.
+#include <SDL3/SDL.h>
+#include <cstdint>
+#include <cstring>
+#include <chrono>
+#include <thread>
+using UINT=unsigned;
+using DWORD=uint32_t;
+constexpr UINT JOYERR_NOERROR=0, JOY_RETURNALL=0xff, JOY_RETURNBUTTONS=0x80, JOY_RETURNPOV=0x40;
+constexpr DWORD JOY_POVCENTERED=0xffff, JOYCAPS_HASPOV=1;
+struct JOYINFOEX { DWORD dwSize{},dwFlags{},dwXpos{},dwYpos{},dwZpos{},dwRpos{},dwUpos{},dwVpos{},dwButtons{},dwPOV{JOY_POVCENTERED}; };
+using LPJOYINFOEX=JOYINFOEX*;
+struct JOYCAPSW { char szPname[256]{}; DWORD wXmin{},wXmax{65535},wYmin{},wYmax{65535},wZmin{},wZmax{65535},wRmin{},wRmax{65535},wUmin{},wUmax{65535},wVmin{},wVmax{65535},wNumButtons{},wNumAxes{},wCaps{}; };
+inline SDL_Joystick* T6RawJoystick(unsigned index) {
+    static bool ready=SDL_InitSubSystem(SDL_INIT_JOYSTICK);
+    if(!ready) return nullptr;
+    int count=0; auto* ids=SDL_GetJoysticks(&count);
+    SDL_Joystick* joy=index<unsigned(count) ? SDL_OpenJoystick(ids[index]) : nullptr;
+    SDL_free(ids); return joy;
+}
+inline UINT joyGetPosEx(unsigned index,JOYINFOEX* info) {
+    auto* joy=T6RawJoystick(index); if(!joy) return 1;
+    DWORD* axes[]={&info->dwXpos,&info->dwYpos,&info->dwZpos,&info->dwRpos,&info->dwUpos,&info->dwVpos};
+    for(int i=0;i<6;++i) *axes[i]=i<SDL_GetNumJoystickAxes(joy)?int(SDL_GetJoystickAxis(joy,i))+32768:32768;
+    info->dwButtons=0;
+    for(int i=0;i<SDL_GetNumJoystickButtons(joy) && i<32;++i) if(SDL_GetJoystickButton(joy,i)) info->dwButtons|=1u<<i;
+    switch(SDL_GetJoystickHat(joy,0)) {
+    case SDL_HAT_UP:info->dwPOV=0;break;case SDL_HAT_RIGHTUP:info->dwPOV=4500;break;
+    case SDL_HAT_RIGHT:info->dwPOV=9000;break;case SDL_HAT_RIGHTDOWN:info->dwPOV=13500;break;
+    case SDL_HAT_DOWN:info->dwPOV=18000;break;case SDL_HAT_LEFTDOWN:info->dwPOV=22500;break;
+    case SDL_HAT_LEFT:info->dwPOV=27000;break;case SDL_HAT_LEFTUP:info->dwPOV=31500;break;
+    default:info->dwPOV=JOY_POVCENTERED;
+    }
+    SDL_CloseJoystick(joy); return 0;
+}
+inline UINT joyGetDevCapsW(unsigned index,JOYCAPSW* caps,unsigned) {
+    auto* joy=T6RawJoystick(index); if(!joy) return 1;
+    const char* name=SDL_GetJoystickName(joy); if(name) std::strncpy(caps->szPname,name,255);
+    caps->wNumButtons=SDL_GetNumJoystickButtons(joy); caps->wNumAxes=SDL_GetNumJoystickAxes(joy);
+    caps->wCaps=SDL_GetNumJoystickHats(joy)>0?JOYCAPS_HASPOV:0;
+    SDL_CloseJoystick(joy); return 0;
+}
